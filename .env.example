# Read-only credentials for the MCP server. scripts/seed_dev.py generates a real
# .env for the local dev stack. For your own cluster, create an API key whose
# role has Security "read" plus read on your log indices (see docs/permissions.md).
DEM_KIBANA_URL=http://localhost:5601
DEM_ES_URL=http://localhost:9200
DEM_KIBANA_SPACE=default
DEM_API_KEY=
# Optional thresholds
# DEM_DEFAULT_LOOKBACK_HOURS=24
# DEM_NOISY_ALERTS_PER_DAY=50
# DEM_MIN_FIELD_COVERAGE_PCT=1.0
# Where enable requests + the audit log live (shared with the approval CLI)
# DEM_STATE_DIR=~/.local/state/detection-enabler-mcp
